// Copy to LocalSigning.xcconfig for personal local signing overrides.
// This file is only an example and should stay committed.

CARAPACE_CODE_SIGN_STYLE = Automatic
CARAPACE_CODE_SIGN_IDENTITY = Apple Development
CARAPACE_DEVELOPMENT_TEAM = YOUR_TEAM_ID

CARAPACE_APP_BUNDLE_ID = ai.carapacefoundation.app
CARAPACE_SHARE_BUNDLE_ID = ai.carapacefoundation.app.share
CARAPACE_APP_GROUP_ID = group.ai.carapacefoundation.app.shared
CARAPACE_ACTIVITY_WIDGET_BUNDLE_ID = ai.carapacefoundation.app.activitywidget
CARAPACE_WATCH_APP_BUNDLE_ID = ai.carapacefoundation.app.watchkitapp

// Leave empty with automatic signing.
CARAPACE_APP_PROFILE =
CARAPACE_SHARE_PROFILE =
CARAPACE_ACTIVITY_WIDGET_PROFILE =
CARAPACE_WATCH_APP_PROFILE =
