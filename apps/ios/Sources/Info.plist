<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).bgrefresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Carapace</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>$(ASSETCATALOG_COMPILER_APPICON_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(CARAPACE_MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.carapacefoundation.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(CARAPACE_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CARAPACE_BUILD_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_carapace-gw._tcp</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Carapace uses your calendars to show events and scheduling context when you enable calendar access.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Carapace uses your calendars to show events and scheduling context when you enable calendar access.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Carapace uses your calendars to add events when you enable calendar access.</string>
	<key>NSCameraUsageDescription</key>
	<string>Carapace uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace.</string>
	<key>NSContactsUsageDescription</key>
	<string>Carapace uses your contacts so you can search and reference people while using the assistant.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Carapace reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Carapace does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Carapace discovers and connects to your Carapace gateway on the local network.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Carapace can share your location in the background when you enable Always.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Carapace uses your location when you allow location sharing.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Carapace uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes.</string>
	<key>NSMotionUsageDescription</key>
	<string>Carapace may use motion data to support device-aware interactions and automations.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Carapace lets your assistant read photos you allow and lets you choose photos to share.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Carapace uses your reminders to list, add, and complete tasks when you enable reminders access.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Carapace uses on-device speech recognition for talk mode and voice wake.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CarapaceAppGroupIdentifier</key>
	<string>$(CARAPACE_ACTIVE_APP_GROUP_ID)</string>
	<key>CarapaceBuildTimestamp</key>
	<string>$(CARAPACE_BUILD_TIMESTAMP)</string>
	<key>CarapaceCanonicalVersion</key>
	<string>$(CARAPACE_IOS_VERSION)</string>
	<key>CarapaceGitCommit</key>
	<string>$(CARAPACE_GIT_COMMIT)</string>
	<key>CarapacePushMode</key>
	<string>$(CARAPACE_PUSH_MODE)</string>
	<key>CarapacePushRelayBaseURL</key>
	<string>$(CARAPACE_PUSH_RELAY_BASE_URL)</string>
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>RedHatDisplay[wght].ttf</string>
		<string>Inter[opsz,wght].ttf</string>
		<string>Inter-Italic[opsz,wght].ttf</string>
		<string>JetBrainsMono-Regular.ttf</string>
		<string>JetBrainsMono-Medium.ttf</string>
		<string>JetBrainsMono-SemiBold.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
