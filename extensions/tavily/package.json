{
  "name": "@carapace/tavily-plugin",
  "version": "2026.9.2",
  "description": "Carapace Tavily plugin",
  "type": "module",
  "dependencies": {
    "typebox": "1.3.18"
  },
  "devDependencies": {
    "@carapace/plugin-sdk": "workspace:*"
  },
  "carapace": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@carapace/tavily-plugin",
      "npmSpec": "@carapace/tavily-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.9",
      "allowInvalidConfigRecovery": true
    },
    "compat": {
      "pluginApi": ">=2026.9.2"
    },
    "build": {
      "carapaceVersion": "2026.9.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Exaggarate/carapace"
  }
}
