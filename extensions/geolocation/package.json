{
  "name": "@carapace/geolocation-plugin",
  "version": "2026.9.2",
  "description": "Carapace geolocation plugin resolving client IP addresses to a coarse city using a locally cached IP-geolocation database.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Exaggarate/carapace"
  },
  "type": "module",
  "dependencies": {
    "maxmind": "5.0.7"
  },
  "devDependencies": {
    "@carapace/plugin-sdk": "workspace:*"
  },
  "carapace": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.9.2"
    },
    "build": {
      "carapaceVersion": "2026.9.2"
    }
  }
}
