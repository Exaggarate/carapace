{
  "name": "@carapace/amazon-bedrock-provider",
  "version": "2026.9.2",
  "description": "Carapace Amazon Bedrock provider plugin with model discovery, embeddings, and guardrail support.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Exaggarate/carapace"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock": "3.1121.0",
    "@aws-sdk/client-bedrock-runtime": "3.1121.0",
    "@aws-sdk/credential-provider-node": "3.972.81",
    "@smithy/node-http-handler": "4.11.3",
    "@smithy/shared-ini-file-loader": "4.7.2",
    "@smithy/types": "4.17.2"
  },
  "devDependencies": {
    "@carapace/plugin-sdk": "workspace:*"
  },
  "carapace": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@carapace/amazon-bedrock-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.9.2"
    },
    "build": {
      "carapaceVersion": "2026.9.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
