{
  "name": "@carapace/moonshot-provider",
  "version": "2026.9.2",
  "description": "Carapace Moonshot provider plugin",
  "type": "module",
  "devDependencies": {
    "@carapace/plugin-sdk": "workspace:*"
  },
  "carapace": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@carapace/moonshot-provider",
      "npmSpec": "@carapace/moonshot-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.9"
    },
    "compat": {
      "pluginApi": ">=2026.9.2"
    },
    "build": {
      "carapaceVersion": "2026.9.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Exaggarate/carapace"
  }
}
