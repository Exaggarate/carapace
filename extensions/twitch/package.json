{
  "name": "@carapace/twitch",
  "version": "2026.9.2",
  "description": "Carapace Twitch channel plugin for chat and moderation workflows.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Exaggarate/carapace"
  },
  "type": "module",
  "dependencies": {
    "@twurple/api-call": "8.1.4",
    "@twurple/auth": "8.1.4",
    "@twurple/chat": "8.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@carapace/plugin-sdk": "workspace:*"
  },
  "carapace": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "setupFeatures": {
      "configPromotion": true
    },
    "install": {
      "npmSpec": "@carapace/twitch",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.9.2"
    },
    "build": {
      "carapaceVersion": "2026.9.2"
    },
    "channel": {
      "id": "twitch",
      "configuredState": {
        "env": {
          "anyOf": [
            "CARAPACE_TWITCH_ACCESS_TOKEN"
          ]
        }
      },
      "label": "Twitch",
      "selectionLabel": "Twitch (Chat)",
      "docsPath": "/channels/twitch",
      "blurb": "Twitch chat integration",
      "aliases": [
        "twitch-chat"
      ],
      "setup": {
        "fields": []
      }
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
