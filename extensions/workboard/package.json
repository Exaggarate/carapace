{
  "name": "@carapace/workboard",
  "version": "2026.9.2",
  "private": true,
  "description": "Carapace dashboard workboard plugin",
  "type": "module",
  "dependencies": {
    "typebox": "1.3.18",
    "@carapace/gateway-protocol": "workspace:*",
    "@carapace/workboard-contract": "workspace:*",
    "lit": "3.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@carapace/gateway-client": "workspace:*",
    "@carapace/normalization-core": "workspace:*",
    "@carapace/plugin-sdk": "workspace:*",
    "carapace": "workspace:*"
  },
  "peerDependencies": {
    "carapace": ">=2026.9.2"
  },
  "peerDependenciesMeta": {
    "carapace": {
      "optional": true
    }
  },
  "carapace": {
    "extensions": [
      "./index.ts"
    ],
    "controlUi": "./browser/index.ts",
    "assetScripts": {
      "build": "node --import ../../scripts/tsx.mjs ../../scripts/build-plugin-control-ui.mts",
      "copy": "node --import ../../scripts/tsx.mjs ../../scripts/build-plugin-control-ui.mts --copy",
      "buildOutputs": [
        "carapace.plugin.json"
      ]
    }
  }
}
