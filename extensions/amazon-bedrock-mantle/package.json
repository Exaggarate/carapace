{
  "name": "@carapace/amazon-bedrock-mantle-provider",
  "version": "2026.9.2",
  "description": "Carapace Amazon Bedrock Mantle provider plugin for OpenAI-compatible model routing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Exaggarate/carapace"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@aws/bedrock-token-generator": "1.1.0"
  },
  "devDependencies": {
    "@carapace/plugin-sdk": "workspace:*"
  },
  "carapace": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@carapace/amazon-bedrock-mantle-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.12-beta.1"
    },
    "compat": {
      "pluginApi": ">=2026.9.2"
    },
    "build": {
      "carapaceVersion": "2026.9.2",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
