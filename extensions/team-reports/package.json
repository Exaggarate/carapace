{
  "name": "@carapace/team-reports",
  "version": "2026.9.2",
  "description": "Carapace team activity reports plugin (GitHub org + Discord activity with model summaries)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Exaggarate/carapace"
  },
  "type": "module",
  "devDependencies": {
    "@carapace/plugin-sdk": "workspace:*",
    "carapace": "workspace:*"
  },
  "peerDependencies": {
    "carapace": ">=2026.9.2"
  },
  "peerDependenciesMeta": {
    "carapace": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "carapace": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@carapace/team-reports",
      "npmSpec": "@carapace/team-reports",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.9.2"
    },
    "compat": {
      "pluginApi": ">=2026.9.2"
    },
    "build": {
      "carapaceVersion": "2026.9.2",
      "bundledDist": false,
      "staticAssets": [
        {
          "source": "./assets/crab.avif",
          "output": "assets/crab.avif"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
