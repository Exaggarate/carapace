{
  "name": "@carapace/voice-call",
  "version": "2026.9.2",
  "description": "Carapace voice-call plugin for Twilio, Telnyx, and Plivo phone calls.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Exaggarate/carapace"
  },
  "type": "module",
  "dependencies": {
    "typebox": "1.3.18",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@carapace/plugin-sdk": "workspace:*",
    "carapace": "workspace:*"
  },
  "peerDependencies": {
    "carapace": ">=2026.9.2"
  },
  "peerDependenciesMeta": {
    "carapace": {
      "optional": true
    }
  },
  "carapace": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-api.ts",
    "install": {
      "npmSpec": "@carapace/voice-call",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=2026.9.2"
    },
    "build": {
      "carapaceVersion": "2026.9.2"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
